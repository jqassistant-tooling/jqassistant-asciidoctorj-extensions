[%autowidth.stretch, options="header"]
|===
|Rule |Status|Severity
<#list constraints as constraint>
|<<jqassistant_${constraint.id}>>
|[<#if constraint.status == "SUCCESS">green<#elseif constraint.status == "FAILURE">red<#elseif constraint.status == "WARNING">yellow<#else>grey</#if>]#${constraint.status}#
|${constraint.severity}
</#list>
<#list concepts as concept>
|<<jqassistant_${concept.id}>>
|[<#if concept.status == "SUCCESS">green<#elseif concept.status == "FAILURE">red<#elseif concept.status == "WARNING">yellow<#else>grey</#if>]#${concept.status}#
|${concept.severity}
</#list>
|===

<#list constraints as constraint>
  <#assign baselineCount = (constraint.hasBaselineResult!false)?then((constraint.baselineRows?size)!0, 0)>
  <#assign suppressedCount = (constraint.hasSuppressedResult!false)?then((constraint.suppressedRows?size)!0, 0)>

  <#if (baselineCount > 0) || (suppressedCount > 0)>

    <#if (baselineCount > 0) && constraint.hasBaselineResult!false>
.Baseline Findings (${baselineCount})
[%collapsible]
====
[%autowidth.stretch, options="header,autowrap"]
|===
|Rule |Status |Severity
|<<jqassistant_${constraint.id},${constraint.id}>> (${constraint.baselineRows?size})
|${constraint.status}
|${constraint.severity}
|===
====
    </#if>

    <#if (suppressedCount > 0) && constraint.hasSuppressedResult!false>
.Suppressed Findings (${suppressedCount})
[%collapsible]
====
[%autowidth.stretch, options="header,autowrap"]
|===
|Rule |Status |Severity
|<<jqassistant_${constraint.id},${constraint.id}>> (${constraint.suppressedRows?size})
|${constraint.status}
|${constraint.severity}
|===
====
    </#if>

  </#if>
</#list>