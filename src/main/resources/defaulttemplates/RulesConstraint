<#list constraints as rule>

[#jqassistant_${rule.id}]
= ${rule.id}
****
<#assign statusConfig = {
   "SUCCESS": {"label": "TIP", "color": "green"},
   "WARNING": {"label": "CAUTION", "color": "yellow"},
   "FAILURE": {"label": "IMPORTANT", "color": "red"}
}>

<#assign current = statusConfig[rule.status]!{"label": "NOTE", "color": "grey"}>

[${current.label}]
====
....
${rule.description}
....
====

<#if rule.hasReports>
<#list rule.reports.links as labeledLink>
link:${labeledLink.link}[${labeledLink.label}]

</#list>
<#list rule.reports.images as labeledImage>
[caption="", title="${labeledImage.label}"]
image::${labeledImage.link}[${labeledImage.label}]

</#list>
<#elseif rule.hasResult || (rule.hasBaselineResult!false) || (rule.hasSuppressedResult!false)>

<#if rule.hasResult>
[%autowidth.stretch, options="header,autowrap"]
|===
<#list rule.resultColumnKeys as key>|${key} </#list>
<#list rule.resultRows as row>
<#list row as cell>
<#if cell?has_content && cell?trim != "">
|${cell?replace(".", ".&#8203;")}
<#else>
|
</#if>
</#list>
</#list>
|===
</#if>

<#if (rule.hasBaselineResult!false) || (rule.hasSuppressedResult!false)>
<#if rule.hasBaselineResult!false>

.Baseline Findings (${rule.baselineRows?size})
[%collapsible]
====
[%autowidth.stretch, options="header,autowrap"]
|===
<#list rule.resultColumnKeys as key>|${key} </#list>
<#list rule.baselineRows as row>
<#list row as cell>
<#if cell?has_content && cell?trim != "">
|${cell?replace(".", ".&#8203;")}
<#else>
|
</#if>
</#list>
</#list>
|===
====
</#if>


<#if rule.hasSuppressedResult!false>
.Suppressed Findings (${rule.suppressedRows?size})
[%collapsible]
====
[%autowidth.stretch, options="header,autowrap"]
|===
<#list rule.resultColumnKeys as key>|${key} </#list>
<#list rule.suppressedRows as row>
<#list row as cell>
<#if cell?has_content && cell?trim != "">
|${cell?replace(".", ".&#8203;")}
<#else>
|
</#if>
</#list>
</#list>
|===
====
</#if>

</#if>

</#if>
[.small]
[grey]#${rule.id} | ${rule.severity}#
****
</#list>