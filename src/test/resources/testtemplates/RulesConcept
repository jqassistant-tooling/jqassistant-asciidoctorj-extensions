<#list concepts as rule>
.${rule.id}
****
<#if rule.status.value == "SUCCESS">
TIP: ${rule.description} +
Status: [green]#${rule.status.value}#, Severity: ${rule.severity.value}
<#elseif rule.status.value == "WARNING">
WARNING: ${rule.description} +
Status: [yellow]#${rule.status.value}#, Severity: ${rule.severity.value}
<#elseif rule.status == "FAILURE">
CAUTION: ${rule.description} +
Status: [red]#${rule.status.value}#, Severity: ${rule.severity.value}
<#else>
NOTE: ${rule.description} +
Status: [grey]#${rule.status.value}#, Severity: ${rule.severity.value}
</#if>

<#if rule.hasReports>
<#list rule.reports.links as labeledLink>
link:${labeledLink.link}[${labeledLink.label}]

</#list>
<#list rule.reports.images as labeledImage>
[caption="", title=${labeledImage.label}]
image::${labeledImage.link}[${labeledImage.label}]

</#list>
<#elseif rule.hasResult>
|===
<#list rule.resultColumnKeys as key>|${key} </#list>
<#list rule.resultRows as row>
<#list row.columns as column>
|${column}
</#list>
</#list>
|===
</#if>
****
</#list>